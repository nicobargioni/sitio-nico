{
  "hosting": {
    "public": "out",
    "trailingSlash": true,
    "cleanUrls": false,
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [
      {
        "source": "/ia-agentes/rag-embeddings/rag-lazy-loading-cloud",
        "destination": "/ia-agentes/rag-embeddings/costo-oculto-rag-cloud",
        "type": 301
      },
      {
        "source": "/nico-bargioni",
        "destination": "/sobre-mi/",
        "type": 301
      },
      {
        "source": "/nico-bargioni/",
        "destination": "/sobre-mi/",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000"
          }
        ]
      },
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  }
}
